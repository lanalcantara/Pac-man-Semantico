@startuml OntologiaPacManSemantico_Parasitology_ALCQ
' ============================================================
' PAC-MAN SEMÂNTICO (CIn-UFPE) — Ontologia Biomédica de Parasitologia
' Modelada no Protégé (OWL/DL ALCQ(D)) + Regras SWRL
' ============================================================

!theme plain
skinparam backgroundColor #0D0D1A
skinparam defaultFontColor #E8E8FF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12

skinparam class {
    BackgroundColor #1A1A2E
    BorderColor #7B68EE
    FontColor #E8E8FF
    ArrowColor #9B59B6
    HeaderBackgroundColor #2D1B69
    StereotypeFontColor #B8860B
}

skinparam note {
    BackgroundColor #1C2840
    BorderColor #4A90D9
    FontColor #D0E8FF
}

title <color:#FFD700><b>PAC-MAN SEMÂNTICO (CIn-UFPE)</b></color>\n<color:#B8B8FF>Ontologia Biomédica de Parasitologia (Protégé OWL / ALCQ(D))</color>\n<color:#888888><i>TBox (Helmintos, Vetores, Hospedeiros, Morfologia) + SWRL + ABox</i></color>

' ============================================================
' TBOX — HIERARQUIA DE CLASSES (Terminological Box)
' ============================================================

package "TBox — Domínio Parasitológico (Protégé OWL)" #1A1A2E {

    abstract class "Thing\n(owl:Thing)" as Thing <<OWL Root>> #2C2C4A

    ' ── PARASITA & TAXONOMIA ────────────────────────────────
    abstract class "Parasite\n(⊑ Thing)" as Parasite <<owl:Class>> #1E3A2F {
        + has_host : Host
        + has_habitat : Habitat
        + has_morphology : Morphology
        + has_transmission : Transmission
        + has_symptom : Symptom
    }

    class "Nematoda\n(⊑ Parasite)" as Nematoda <<Helmintos Cilíndricos>> #00A86B {
        ──────────────────────
        <b>Axioma Equivalente DL:</b>
        Nematoda ≡ Parasite ⊓
        ∃has_morphology.Cylindrical
    }

    class "Platyhelminthes\n(⊑ Parasite)" as Platyhelminthes <<Platelmintos Planos>> #8E44AD {
        ──────────────────────
        <b>Axioma Equivalente DL:</b>
        Platyhelminthes ≡ Parasite ⊓
        ∃has_morphology.FlatSegments
    }

    class "AscarisLumbricoides\n(⊑ Nematoda)" as AscarisLumbricoides <<Espécie Parasita>> #00FFCC {
        ──────────────────────
        <b>Axioma DL:</b>
        AscarisLumbricoides ≡ Nematoda ⊓
        ∃has_host.Human ⊓
        ∃has_habitat.SmallIntestine ⊓
        ∃has_transmission.FecalOral
    }

    class "EnterobiusVermicularis\n(⊑ Nematoda)" as EnterobiusVermicularis <<Espécie Parasita>> #38BDF8 {
        ──────────────────────
        <b>Axioma DL:</b>
        EnterobiusVermicularis ≡ Nematoda ⊓
        ∃has_host.Human ⊓
        ∃has_habitat.PerianalRegion ⊓
        ∃has_transmission.Autoinfection
    }

    class "TaeniaSolium\n(⊑ Platyhelminthes)" as TaeniaSolium <<Espécie Parasita>> #FFD700 {
        ──────────────────────
        <b>Axioma DL:</b>
        TaeniaSolium ≡ Platyhelminthes ⊓
        ∃has_host.Human ⊓
        ∃has_habitat.SmallIntestine ⊓
        ∃has_transmission.UndercookedPork
    }

    ' ── HOSPEDEIRO, HABITAT, MORFOLOGIA ─────────────────────
    abstract class "Host\n(⊑ Thing)" as Host <<owl:Class>> #2A1A3A
    class "Human\n(⊑ Host)" as Human #4A2E6D
    class "Pig\n(⊑ Host)" as Pig #4A2E6D

    abstract class "Habitat\n(⊑ Thing)" as Habitat <<owl:Class>> #1C3A3A
    class "SmallIntestine\n(⊑ Intestine)" as SmallIntestine #2A5A5A
    class "LargeIntestine\n(⊑ Intestine)" as LargeIntestine #2A5A5A
    class "PerianalRegion\n(⊑ Habitat)" as PerianalRegion #2A5A5A

    abstract class "Morphology\n(⊑ Thing)" as Morphology <<owl:Class>> #3A2A1A
    class "Cylindrical\n(⊑ Morphology)" as Cylindrical #5A3A1A
    class "FlatSegments\n(⊑ Morphology)" as FlatSegments #5A3A1A

    abstract class "Transmission\n(⊑ Thing)" as Transmission <<owl:Class>> #3A1A2A
    class "FecalOral\n(⊑ Transmission)" as FecalOral #5A1A3A
    class "UndercookedPork\n(⊑ Transmission)" as UndercookedPork #5A1A3A
    class "Autoinfection\n(⊑ Transmission)" as Autoinfection #5A1A3A

    ' ── AGENTES E DINÂMICA DA SIMULAÇÃO ─────────────────────
    class "BiomedicalResearcher\n(Pac-Man)" as Researcher <<Agente Investigador>> #FFD700 {
        + sampleCount : int
        + hasState : State
    }

    class "InfectionVector\n(Fantasma / Blinky)" as InfectionVector <<Vetor / Ameaça>> #FF4444 {
        + vectorType : string
        + isVulnerable : boolean
    }

    class "AntiparasiticTreatment\n(Power Pellet)" as AntiparasiticTreatment <<Intervenção Terapêutica>> #FF8C00 {
        + treatmentDuration : float
    }

    class "InconsistentParasiteSpecimen\n(Obstáculo)" as InconsistentSpecimen <<Violação DL>> #8B0000 {
        + dlViolation : "(Cylindrical ⊓ FlatSegments ≡ ⊥)"
    }
}

' ============================================================
' HIERARQUIA DE HERANÇA (rdfs:subClassOf)
' ============================================================

Thing <|-- Parasite : rdfs:subClassOf
Thing <|-- Host     : rdfs:subClassOf
Thing <|-- Habitat  : rdfs:subClassOf
Thing <|-- Morphology : rdfs:subClassOf
Thing <|-- Transmission : rdfs:subClassOf

Parasite <|-- Nematoda : rdfs:subClassOf
Parasite <|-- Platyhelminthes : rdfs:subClassOf

Nematoda <|-- AscarisLumbricoides : rdfs:subClassOf
Nematoda <|-- EnterobiusVermicularis : rdfs:subClassOf
Platyhelminthes <|-- TaeniaSolium : rdfs:subClassOf

Host <|-- Human : rdfs:subClassOf
Host <|-- Pig   : rdfs:subClassOf

Morphology <|-- Cylindrical : rdfs:subClassOf
Morphology <|-- FlatSegments : rdfs:subClassOf

Transmission <|-- FecalOral : rdfs:subClassOf
Transmission <|-- UndercookedPork : rdfs:subClassOf
Transmission <|-- Autoinfection : rdfs:subClassOf

' ============================================================
' OBJECT PROPERTIES (Propriedades de Objeto OWL)
' ============================================================

Parasite --> Host         : has_host\n<i>(owl:ObjectProperty)</i>
Parasite --> Habitat      : has_habitat\n<i>(owl:ObjectProperty)</i>
Parasite --> Morphology   : has_morphology\n<i>(owl:ObjectProperty)</i>
Parasite --> Transmission : has_transmission\n<i>(owl:ObjectProperty)</i>

Researcher --> Parasite   : collects\n<i>(owl:ObjectProperty)</i>
Researcher --> InfectionVector : isNearTo\n<i>(Symmetric)</i>

' ============================================================
' REGRAS LÓGICAS / AXIOMAS (SWRL & DL)
' ============================================================

note as R1 #1C2840
  <b><color:#FFD700>Regra SWRL 1 — Eficácia Terapêutica</color></b>
  ─────────────────────────────────────────────
  <b>Premissa:</b>
  BiomedicalResearcher(r) ∧ AntiparasiticTreatment(t) ∧
  consumes(r, t) ∧ isNearTo(r, v) ∧ InfectionVector(v)
  <b>Conclusão:</b>
  hasState(v, VulnerableState)
  ─────────────────────────────────────────────
  <i>A aplicação do tratamento antiparasitário</i>
  <i>neutraliza e torna vulneráveis os vetores</i>
  <i>infecciosos no ambiente espacial.</i>
end note

note as R2 #1C2840
  <b><color:#00FFCC>Regra DL 2 — Conformidade de Espécime</color></b>
  ─────────────────────────────────────────────
  AscarisLumbricoides ⊑ Nematoda ⊓
     ∃has_host.Human ⊓
     ∃has_habitat.SmallIntestine ⊓
     ∃has_transmission.FecalOral
  ─────────────────────────────────────────────
  <i>Espécimes conformes geram pontuação diagnóstica</i>
  <i>positiva e validação taxonômica no HUD.</i>
end note

note as R3 #1C2840
  <b><color:#FF8C00>Regra DL 3 — Inconsistência Morfológica</color></b>
  ─────────────────────────────────────────────
  Cylindrical ⊓ FlatSegments ≡ ⊥
  InconsistentSpecimen ⊑ ∃has_morphology.⊥
  ─────────────────────────────────────────────
  <i>Espécimes com atributos mutuamente</i>
  <i>exclusivos são classificados como</i>
  <i>obstáculos ontológicos instransponíveis.</i>
end note

R1 .. AntiparasiticTreatment
R2 .. AscarisLumbricoides
R3 .. InconsistentSpecimen

' ============================================================
' ABOX — INSTÂNCIAS (Assertional Box)
' ============================================================

package "ABox — Instâncias Clínicas e Laboratoriais" #0F0F1F {
    object "sample_ascaris_01 : AscarisLumbricoides" as i1 <<Nematoda>> #006655 {
        id = "sample_ascaris_01"
        has_host = "human1"
        has_habitat = "smallintestine1"
        has_transmission = "fecaloral1"
        has_morphology = "cylindrical1"
    }
    object "sample_enterobius_01 : EnterobiusVermicularis" as i2 <<Nematoda>> #005577 {
        id = "sample_enterobius_01"
        has_host = "human1"
        has_habitat = "perianalregion1"
        has_transmission = "autoinfection1"
    }
    object "sample_taenia_01 : TaeniaSolium" as i3 <<Platyhelminthes>> #775500 {
        id = "sample_taenia_01"
        has_host = "human1"
        has_habitat = "smallintestine1"
        has_transmission = "undercookedpork1"
    }
    object "vector_triatomine_01 : InfectionVector" as i4 <<InfectionVector>> #550000 {
        id = "vector_triatomine_01"
        vectorType = "TriatomaInfestans"
        hasState = "Patrol"
    }
}

AscarisLumbricoides <.. i1 : rdf:type
EnterobiusVermicularis <.. i2 : rdf:type
TaeniaSolium <.. i3 : rdf:type
InfectionVector <.. i4 : rdf:type

@enduml
